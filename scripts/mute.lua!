local app=DoApp.DoApp()
app:doCommand([[Window.ShowBottomPanel?Set=true]])
app:doCommand([[View.ZoomScoreLayoutView?ScoreLayoutViewID=0&ZoomLevelType=kPercent&ZoomPercent=146]])
app:doCommand([[UI.InvokePropertyEnableSwitch?Type=kEventMuted&Value=false]])
app:doCommand([[UI.InvokePropertyChangeValue?Type=kEventMuted&Value=string: "kAlways"]])
app:doCommand([[UI.InvokePropertyEnableSwitch?Type=kEventColour&Value=false]])
app:doCommand([[UI.InvokePropertyChangeValue?Type=kEventColour&Value=string: "#ff000000"]])
app:doCommand([[UI.InvokePropertyChangeValue?Type=kEventColour&Value=string: "#ffaa00ff"]])
app:doCommand([[Window.ShowBottomPanel?Set=false]])
app:doCommand([[View.ZoomScoreLayoutView?ScoreLayoutViewID=0&ZoomLevelType=kPercent&ZoomPercent=146]])
